# Copy this file to .env and fill in your own Supabase project values.
# These are the public anon/publishable key and project URL — safe to
# expose client-side by design, since Row Level Security enforces data
# access. Never put service-role keys or third-party API secrets here;
# those belong only in Supabase Edge Function secrets.

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co